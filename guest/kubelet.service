[Unit]
Description=Kubernetes kubelet
Requires=containerd.service demo-registry.service
Wants=network-online.target
After=network-online.target containerd.service demo-registry.service
StartLimitIntervalSec=0

[Service]
Environment=PATH=/opt/bin:/usr/sbin:/usr/bin
EnvironmentFile=-/var/lib/kubelet/kubeadm-flags.env
ExecStart=/opt/bin/kubelet --bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf --kubeconfig=/etc/kubernetes/kubelet.conf --config=/var/lib/kubelet/config.yaml $KUBELET_KUBEADM_ARGS
Restart=always
RestartSec=10
Delegate=yes

[Install]
WantedBy=multi-user.target
