{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IG Demo",
  "version": "0.1.0",
  "identifier": "io.inspektor-gadget.demo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Inspektor Gadget Demo",
      "width": 1180,
      "height": 780,
      "minWidth": 800,
      "minHeight": 620
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "A local Inspektor Gadget demo appliance",
    "category": "DeveloperTool"
  }
}
